{
  "name": "spot_check",
  "description": "Screenshot all five tabs plus shop, settings, and global search.",
  "restore_dark": true,
  "steps": [
    { "action": "boot" },
    { "action": "install" },
    { "action": "navigate", "target": "tab", "value": "today" },
    { "action": "wait", "seconds": 1.4 },
    { "action": "screenshot", "name": "tab-today" },
    { "action": "navigate", "target": "tab", "value": "calendar" },
    { "action": "wait", "seconds": 1.2 },
    { "action": "screenshot", "name": "tab-calendar" },
    { "action": "navigate", "target": "tab", "value": "meals" },
    { "action": "wait", "seconds": 1.2 },
    { "action": "screenshot", "name": "tab-meals" },
    { "action": "navigate", "target": "tab", "value": "matrix" },
    { "action": "wait", "seconds": 1.2 },
    { "action": "screenshot", "name": "tab-matrix" },
    { "action": "navigate", "target": "tab", "value": "habits" },
    { "action": "wait", "seconds": 1.2 },
    { "action": "screenshot", "name": "tab-habits" },
    { "action": "swipe", "x1": 220, "y1": 920, "x2": 220, "y2": 520 },
    { "action": "wait", "seconds": 0.8 },
    { "action": "screenshot", "name": "app-grid" },
    { "action": "tap-label", "label": "wheel-app-calendar", "match_key": "AXUniqueId" },
    { "action": "wait", "seconds": 0.8 },
    { "action": "screenshot", "name": "grid-pick-calendar" },
    { "action": "navigate", "target": "open", "value": "shop" },
    { "action": "wait", "seconds": 1.6 },
    { "action": "screenshot", "name": "shop" },
    { "action": "navigate", "target": "open", "value": "settings" },
    { "action": "wait", "seconds": 1.0 },
    { "action": "screenshot", "name": "settings" },
    { "action": "navigate", "target": "open", "value": "search" },
    { "action": "wait", "seconds": 1.0 },
    { "action": "screenshot", "name": "global-search" }
  ]
}
